---
source: ito/tests/hcl_edit.rs
expression: "eval_str(&format!(\"{DOC}\\\n         h.add(hcl::block(\\\"output\\\").with_label(\\\"id\\\").with_attribute(\\\"value\\\", \\\"x\\\"));\\n\\\n         h.to_string()\"))"
---
region = "us-east-1"

resource "aws_instance" "web" {
  ami = "old" # keep
  count = 2
}

resource "aws_instance" "db" {
  ami = "old2"
}
output "id" {
  value = "x"
}
