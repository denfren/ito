---
source: ito/tests/hcl_edit.rs
expression: "eval_str(&format!(\"{DOC}\\\n         h.block(\\\"resource\\\",\\\"aws_instance\\\",\\\"db\\\").add(\\\"monitoring\\\", true);\\n\\\n         h.to_string()\"))"
---
region = "us-east-1"

resource "aws_instance" "web" {
  ami = "old" # keep
  count = 2
}

resource "aws_instance" "db" {
  ami = "old2"
  monitoring = true
}
